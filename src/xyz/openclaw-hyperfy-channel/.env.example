# Bridge server
PORT=8787
LOG_LEVEL=info

# Hyperfy agent websocket endpoint (your Hyperfy server exposes /ws/agents)
HYPERFY_WS_URL=ws://host.docker.internal:3000/ws/agents
HYPERFY_AGENT_NAME=OpenClawBot
# Optional avatar URL/ID depending on your Hyperfy setup
HYPERFY_AGENT_AVATAR=

# OpenClaw webhook target (incoming messages -> agent)
# Example: http://openclaw:3000/hooks/agent
OPENCLAW_HOOK_URL=http://host.docker.internal:3001/hooks/agent
OPENCLAW_AGENT=hyperfy-bot
# Optional auth (if your OpenClaw deployment requires it)
OPENCLAW_HOOK_BEARER_TOKEN=
OPENCLAW_WEBHOOK_SECRET=

# Outbound delivery (OpenClaw channel plugin -> bridge -> Hyperfy)
# If set, plugin must send this token in Authorization: Bearer <token>
BRIDGE_OUTBOUND_TOKEN=change-me

# Channel identity seen by OpenClaw
HYPERFY_CHANNEL_ID=hyperfy:default:global
HYPERFY_CHANNEL_NAME=Hyperfy Global
